- user ||= @user
- destination ||= false
- unique_session_id = user.unique_session_id.presence || User.for_authentication(user.uid).unique_session_id

.standard-modal-overlay.active
  .standard-modal-container.active
    = form_for user, url: droom_client.set_password_user_path(user), method: "PUT", html: {class: "user setup custom-validate"} do |f|
      = hidden_field_tag :tok, unique_session_id
      - if destination
        = hidden_field_tag :destination, destination

      .standard-modal-header
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}

        .container
          %h2
            Set up your account

          %br

          %p.std-mt
            Create a password to get started.

      .standard-modal-body
        .container.std-mt
          .inputs
            .std-row
              .input-group
                = f.text_field :given_name, required: true, placeholder: t("placeholders.user.given_name"), data: { validation_message: "Please enter your first name" }
              .input-group
                = f.text_field :family_name, required: true, placeholder: t("placeholders.user.family_name"), data: { validation_message: "Please enter your last name" }

            .input-group
              = f.password_field :password, placeholder: t("placeholders.user.password"), required: true, minlength: 8, data: { validation_message: "Password must be at least 8 characters" }
              %button.eye-icon{type: "button"}
                %img{alt: "open", src: "https://croucher.org.hk/assets/images/icons/eye-02.svg"}/

      .standard-modal-footer
        .buttons
          = f.submit t(:continue), class: 'submit croucher-standard-btn'
