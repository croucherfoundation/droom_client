- user ||= f.object
  
.croucher_input.passwords-input.passwords-input-primary
  = f.password_field :password, placeholder: t("placeholders.user.password"), data: {role: "password"}, autocomplete: false, readonly: true, onfocus: "this.removeAttribute('readonly');"
  %span
    %img.passwords-eye{alt: "Eye", src: "https://cmss.croucher.org.hk/assets/images/icons/eye-02.svg"}
  %p.error_message.account_settings_error_message
.croucher_input.passwords-input.passwords-input-confirm
  = f.password_field :password_confirmation, placeholder: ""
  %span
    %img.passwords-eye{alt: "Eye", src: "https://cmss.croucher.org.hk/assets/images/icons/eye-02.svg"}/
  %p.error_message.account_settings_error_message