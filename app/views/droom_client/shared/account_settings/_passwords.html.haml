- user ||= f.object

.croucher_input.passwords-input.passwords-input-primary
  = f.password_field :password, placeholder: t("placeholders.user.password"), required: true, minlength: 8, data: {validation_message: "Password must be at least 8 characters"}, autocomplete: false
  %span
    %img.passwords-eye{alt: "Eye", src: "https://croucher.org.hk/assets/images/icons/eye-02.svg"}
  %p.error_message.account_settings_error_message
