- user ||= User.new_with_defaults(email: params[:email])
- if params[:destination]
  - backto = params[:destination]
- elsif stored_location = controller.stored_location_for(:user)
  - backto = URI.join(local_host, stored_location).to_s if stored_location

- is_signin_page = controller_name == 'user_sessions' && action_name == 'new'
- unless is_signin_page
  - is_signin_page = !user_signed_in? && controller_name == 'wiki'

%section#signin-box.auth_container{class: ('auth_container_open' if is_signin_page || params[:failed].present? || params[:not_confirmed].present?)}
  .auth_container_wrapper
    .croucher_container
      .cross_icon_container
        %button{disabled: is_signin_page}
          %svg{fill: "none", height: "23", viewbox: "0 0 24 23", width: "24", xmlns: "http://www.w3.org/2000/svg"}
            %line{stroke: (is_signin_page ? "#F8F8F6" : "#D3D3D3"), "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 -0.694719 0.765788 0.643093 1.93701 22.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
            %line{stroke: (is_signin_page ? "#F8F8F6" : "#D3D3D3"), "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 0.694719 -0.669051 0.743216 0 1.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}

    .croucher_container
      %h2.text-subtitle Sign in

      = form_for(user, url: droom_client.sign_in_path, method: 'post', html: { class: 'sign_in_form', autocomplete: 'off' }) do |f|
        = hidden_field_tag :destination, params[:destination]
        = hidden_field_tag :begin_application, params[:begin_application]

        .input_group
          %label{for: "email"} Email
          = f.text_field :email, class: ("has-error" if params[:failed].present? || params[:not_confirmed].present? ), placeholder: t("placeholders.signin.email"), autocomplete: 'off', id: ('u_s_e_a' unless params[:failed].present? || params[:not_confirmed].present?)

        .input_group
          %label{for: "password"} Password
          = f.password_field :password, class: "sign_in_password #{'has-error' if params[:failed].present? || params[:not_confirmed].present?}", placeholder: t("placeholders.signin.password"), autocomplete: 'new-password', id: ('u_s_p_f' unless params[:failed].present? || params[:not_confirmed].present?)
          %button.eye{type: "button"}
            %img{alt: "open", src: "https://croucher.org.hk/assets/images/icons/eye-02.svg"}/

        .sign_in_btn
          = f.submit t(:sign_in), class: "croucher-standard-btn", data: {turbo: false}

      - if params[:failed].present?
        %p.error_message
          Incorrect email or password.

      - if params[:not_confirmed].present?
        %p.error_message
          We haven't received your confirmation. Please check your email.

      .forgot_password
        %p.mb-2
          %button.underline{data: {'toggle': 'modal', 'target': 'passwordModal', turbo: false}}
            Forgot password?

        %p.pb-0
          Don't have a Croucher account?
          %button.underline{data: {'toggle': 'modal', 'target': 'signupModal', turbo: false}}
            Click here to create one.
