- user ||= User.new_with_defaults(email: params[:email])

%section#signin-box.auth_container
  .auth_container_wrapper
    .croucher_container
      .cross_icon_container
        %button
          %svg{fill: "none", height: "23", viewbox: "0 0 24 23", width: "24", xmlns: "http://www.w3.org/2000/svg"}
            %line{stroke: "#D3D3D3", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 -0.694719 0.765788 0.643093 1.93701 22.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
            %line{stroke: "#D3D3D3", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 0.694719 -0.669051 0.743216 0 1.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
    .croucher_container
      %h2.text-subtitle Sign in

      = form_for(user, url: droom_client.sign_in_path, method: 'post', html: { class: 'sign_in_form' }) do |f|
        = hidden_field_tag :destination, params[:destination]
        
        .input_group
          %label{for: "email"} Email
          = f.email_field :email, class: 'rounded-b-5 mb-1 outline-none border-none', placeholder: t("placeholders.signin.email")
        
        .input_group
          %label{for: "password"} Password
          = f.password_field :password, class: 'rounded-b-5 mb-1 outline-none border-none sign_in_password', placeholder: t("placeholders.signin.password")
          %button.eye{type: "button"}
            %img{alt: "open", src: "https://cmss.croucher.org.hk/assets/images/icons/eye-02.svg"}/

        .sign_in_btn
          = f.submit t(:sign_in), class: "croucher-standard-btn"

      .forgot_password
        %p.pb-0
          Don't have a Croucher account?
          %button.underline{data: {'toggle': 'modal', 'target': 'signupModal'}} 
            Click here to create one.
