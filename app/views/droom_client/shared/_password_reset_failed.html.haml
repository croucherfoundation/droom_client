#passwordResetFailureModal.modal
  .modal-wrapper{role: "document"}
    .standard-modal-overlay.active
      .standard-modal-container.active
        .standard-modal-close-btn.cursor-pointer
          %svg.standard_close_icon{fill: "none", height: "23", viewbox: "0 0 24 23", width: "24", xmlns: "http://www.w3.org/2000/svg"}
            %line{stroke: "#D3D3D3 ", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 -0.694719 0.765788 0.643093 1.93701 22.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
            %line{stroke: "#D3D3D3", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 0.694719 -0.669051 0.743216 0 1.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}
        .container
          %h2 Password reset instructions not delivered
          .form-fields
            %section.m-0
              %p.alert-message
                
        %section.actions.buttons.m-0
          %button.croucher-standard-btn.modal-btn.cancel.submit-button{type: "button"}
            Close
