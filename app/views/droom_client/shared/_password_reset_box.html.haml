- user ||= User.new_with_defaults
#passwordModal.modal{"data-turbo" => "false"}
  .modal-wrapper{role: "document"}
    -# .modal-content
      -# .croucher_container.my-custom-modal-content
    .standard-modal-overlay.active
      .standard-modal-container.active
        %svg.logo.ml-56
          %use{"xlink:href" => "#croucher_logo"}
        = form_for(user, url: droom_client.reset_password_path,  method: 'post', :html => {:class => 'edit user password', :autocomplete => false}) do |f|
          .container
            %h2 Reset your password
            .form-fields.inputs
              %section
                %p
                  = t :forgot_password_title
                %p.mb-3
                  = t :password_reset_instructions
                .email
                  .email-input
                    = f.email_field :email,  :placeholder => t('placeholders.signin.email'), :required => true, class: "required bd-radius-unset"
          %section.actions.buttons
            %button.modal-btn.cancel.submit-button{type: "button"}
              Cancel
            %button.password-reset-btn.croucher-standard-btn.submit.save{type: 'button'}
              Send

= render 'droom_client/shared/password_email_confirm'
