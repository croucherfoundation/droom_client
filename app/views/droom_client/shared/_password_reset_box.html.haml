- user ||= User.new_with_defaults
#passwordModal.modal{"data-turbo" => "false"}
  .modal-wrapper{role: "document"}
    -# .modal-content
      -# .croucher_container.my-custom-modal-content
    .standard-modal-overlay.active
      .standard-modal-container.active
        .standard-modal-close-btn.cursor-pointer
          %svg.standard_close_icon{fill: "none", height: "23", viewbox: "0 0 24 23", width: "24", xmlns: "http://www.w3.org/2000/svg"}
            %line{stroke: "#D3D3D3 ", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 -0.694719 0.765788 0.643093 1.93701 22.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
            %line{stroke: "#D3D3D3", "stroke-linecap" => "round", "stroke-width" => "2", transform: "matrix(0.719281 0.694719 -0.669051 0.743216 0 1.1875)", x1: "1", x2: "29.4986", y1: "-1", y2: "-1"}
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}
        = form_for(user, url: droom_client.reset_password_path,  method: 'post', :html => {:class => 'edit_user password', :autocomplete => false}) do |f|
          .container
            %h2 Reset your password
            .form-fields.inputs
              %section.m-0
                %p
                  = t :forgot_password_title
                %p.mb-3
                  = t :password_reset_instructions
                .email-input
                  = f.email_field :email,  :placeholder => t('placeholders.signin.email'), :required => true, class: "required bd-radius-unset"
          %section.actions.buttons.m-0
            %button.modal-btn.cancel.submit-button{type: "button"}
              Cancel
            %button.password-reset-btn.croucher-standard-btn.submit.save{type: 'button'}
              Send

= render 'droom_client/shared/password_email_confirm'
= render 'droom_client/shared/password_reset_failed'
