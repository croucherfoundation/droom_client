- user ||= User.new_with_defaults
#passwordModal.modal{"data-turbo" => "false"}
  .modal-wrapper{role: "document"}
    .modal-content
      .croucher_container.my-custom-modal-content
        = form_for(user, url: droom_client.reset_password_path,  method: 'post', :html => {:class => 'edit user password', :autocomplete => false}) do |f|
          %h1 Reset your password
          .form-fields
            %section
              %p
                = t :forgot_password_title
              %p.mb-3
                = t :password_reset_instructions
              .email
                .email-input
                  = f.email_field :email,  :placeholder => t('placeholders.signin.email'), :required => true, class: "required"
            %section.actions
              %button.croucher-standard-btn.modal-btn.cancel{type: "button"}
                Cancel
              %button.password-reset-btn.croucher-standard-btn.save{type: 'button'}
                Send

= render 'droom_client/shared/password_email_confirm'
