
#passwordConfirmModal.modal
  .modal-wrapper{role: "document"}
    .standard-modal-overlay.active
      .standard-modal-container.active
        %svg.logo
          %use{"xlink:href" => "#croucher_logo"}
        .container
          %h2 Password reset instructions sent
          .form-fields
            %section.m-0
              %p
                = t :password_reset_sent

        %section.actions.buttons.m-0
          %button.croucher-standard-btn.modal-btn.cancel.submit-button{type: "button"}
            Close
